{
    "name": "preact-signals-store",
    "version": "1.0.3",
    "description": "A lightweight, type-safe reactive state management library built on @preact/signals-core",
    "keywords": [
        "preact",
        "signals",
        "state-management",
        "reactive",
        "store",
        "typescript",
        "react"
    ],
    "author": "",
    "license": "ISC",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/OhadC/preact-signals-store.git",
        "directory": "packages/preact-signals-store"
    },
    "homepage": "https://github.com/OhadC/preact-signals-store#readme",
    "bugs": {
        "url": "https://github.com/OhadC/preact-signals-store/issues"
    },
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        ".": {
            "types": {
                "import": "./dist/index.d.mts",
                "require": "./dist/index.d.cts"
            },
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        }
    },
    "scripts": {
        "build": "tsdown",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "release": "pnpm publish --no-git-checks --provenance --access public"
    },
    "sideEffects": false,
    "peerDependencies": {
        "@preact/signals-core": "^1.0.0"
    },
    "devDependencies": {
        "@preact/signals-core": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "files": [
        "dist"
    ]
}
